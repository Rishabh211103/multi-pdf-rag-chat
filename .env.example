# ---------- LLM ----------
# groq (free) | ollama (free, local) | anthropic | openai
LLM_PROVIDER=groq
# Leave empty to use the provider default
# (groq: openai/gpt-oss-120b, anthropic: claude-sonnet-5-5, openai: gpt-4o-mini, ollama: llama3.1)
LLM_MODEL=
LLM_MAX_TOKENS=1024

# Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Use http://host.docker.internal:11434 when running the API in Docker
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Embeddings ----------
# onnx (local, free, no PyTorch) | huggingface (needs sentence-transformers) | openai | ollama
# NOTE: changing the embedding provider/model requires re-indexing (delete the data/ folder).
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=

# ---------- Chunking & retrieval ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=20
USE_MMR=true
MAX_HISTORY_TURNS=6

# ---------- Storage ----------
DATA_DIR=data
COLLECTION_NAME=pdf_chunks
MAX_UPLOAD_MB=50
